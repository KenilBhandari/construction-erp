# ==============================================================================
# Dependencies & Package Managers
# ==============================================================================
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ==============================================================================
# Environment & Secrets
# ==============================================================================
# Ignore all .env files by default
.env*
# Never commit local overrides or credentials
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# OPT-IN: Explicitly allow committing example/template env files
!.env.example
!.env.template
!.env*.example

# ==============================================================================
# Next.js & Build Outputs
# ==============================================================================
.next/
out/
build/
dist/

# NOTE: Do NOT ignore `next-env.d.ts`. Next.js requires it for proper TypeScript
# compilation in CI/CD environments.

# Turborepack / Turborepo cache
.turbo/

# ==============================================================================
# Testing & Code Coverage
# ==============================================================================
coverage/
*.lcov
.nyc_output/

# End-to-End (Playwright / Cypress)
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/

# Storybook
storybook-static/

# ==============================================================================
# TypeScript & Linters
# ==============================================================================
*.tsbuildinfo
.eslintcache
.stylelintcache

# ==============================================================================
# Logs & Debugging
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Core dumps / runtime diagnostics
core
core.*
.v8flags*.json

# ==============================================================================
# Hosting & Cloud Deployment
# ==============================================================================
.vercel
.serverless/
.sst/
.amplify/
.firebase/

# ==============================================================================
# IDE & System Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editors (keep project settings, ignore user-specific state)
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# VS Code (ignore workspace state, but allow team settings/extensions)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# Temp debug scripts
scripts/*-tmp.ts
src/app/api/debug-auth/

# Temp debug scripts
scripts/*-tmp.ts
src/app/api/debug-auth/
